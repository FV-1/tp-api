# Variables de sandboxd. Aucune valeur ici : les secrets ne vont jamais dans Git.
# make run crée .env (ignoré par Git) avec des secrets aléatoires s'il n'existe pas.
# Pour un client dans un autre terminal : set -a; . ./.env; set +a

# Clé de l'opérateur, envoyée dans l'en-tête X-Operator-Key (32 octets au moins)
SANDBOXD_OPERATOR_KEY=
# Secret de signature des jetons d'agent JWT (32 octets au moins, distinct de la clé)
SANDBOXD_JWT_SECRET=
# Journal d'audit, une ligne JSON par action (défaut : audit.log)
SANDBOXD_AUDIT_LOG=
# Nombre maximal de sandboxes actives (défaut : 10)
SANDBOXD_MAX_SANDBOXES=
