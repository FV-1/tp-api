# Copy these values into your shell environment before starting the API.
# Replace both placeholders with independent random secrets (at least 32 bytes).
SANDBOXD_OPERATOR_KEY=replace-with-a-random-operator-key-at-least-32-bytes
SANDBOXD_JWT_SECRET=replace-with-a-separate-random-jwt-secret-at-least-32-bytes
SANDBOXD_AUDIT_LOG=./audit.log
